# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email (Resend)
RESEND_API_KEY="re_xxxxx"
EMAIL_FROM="noreply@finagevolata.it"

# Google AI (Gemma/Embeddings)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-key"

# Comma-separated emails auto-promoted to ADMIN on next login
ADMIN_EMAILS=

# CCIAA provider for VAT lookup: auto | openapi | vies | mock
# auto (default): openapi.it -> VIES -> mock (dev only)
# openapi: openapi.com Company API only (paid, requires token)
# vies: free EU validation, no ATECO/legal form
# mock: local fixture data
CCIAA_PROVIDER=auto

# OpenAPI.com Company API Bearer token (https://console.openapi.com)
# Tier options: IT-start, IT-advanced, IT-full, IT-closed
OPENAPI_IT_TOKEN=
OPENAPI_IT_TIER=IT-start
OPENAPI_IT_SANDBOX=false

# OpenAI key for ATECO inference fallback when openapi.it token missing
# Used by OpenAiAtecoProvider to guess ATECO code from company name + VIES data
OPENAI_API_KEY=
OPENAI_ATECO_MODEL=gpt-4o-mini

# Click Day partner — destinatario email pacchetto Click Day (MouseX)
# Senza questa env var, l'azione exportForClickDay restituisce un errore.
MOUSEX_EMAIL=clickday@mousex.it
